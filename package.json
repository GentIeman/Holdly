{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "dev:api": "pnpm --filter holdly-api dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:eslint": "eslint . --ext .ts,.vue,.mjs,.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@nuxt/ui": "4.3.0",
    "@pinia/nuxt": "0.11.3",
    "@vuetify/v0": "^1.0.1",
    "nuxt": "^4.2.2",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@nuxt/eslint": "^1.4.1",
    "concurrently": "^9.1.0",
    "oxfmt": "^0.59.0",
    "typescript": "^5.6.3"
  }
}