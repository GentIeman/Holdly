{
  "name": "vue-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:api": "pnpm --filter holdly-api dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "preview": "vite preview",
    "lint:oxlint": "oxlint .",
    "typecheck": "vue-tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@vuetify/v0": "^1.0.3",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}