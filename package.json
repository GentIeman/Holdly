{
  "name": "vue-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:api": "pnpm --filter holdly-api dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "preview": "vite preview",
    "lint:oxlint": "oxlint .",
    "typecheck": "vue-tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@vuetify/v0": "^1.3.0",
    "ofetch": "1.5.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}